  "cadillac": {
    "historicalContext": "Silverstone gave Cadillac a sharper read on its Austria-era package on a high-speed, long-lap circuit: the team used Saturday's Sprint running to gather tire and high-speed balance information, then still ended Grand Prix qualifying with both MAC-26s in Q1. Bottas maximized what he called one of his better qualifying sessions of the year for P18, 0.547s shy of the Q2 cut, while Pérez struggled with high-speed balance and front-end grip on the way to P20, keeping Cadillac ahead of Aston Martin but still behind the Williams/Haas/Alpine edge of the midfield.",
    "driverNotes": {
      "BOT": {
        "headline": "Bottas completed Cadillac's first full race distance with the Austria upgrade and was classified P16 after Sainz's Safety Car infringement, finally giving the team race-length package data after recent DNFs.",
        "tag": "first-upgrade-distance-final-p16"
      },
      "PER": {
        "headline": "Perez started P20, caught the Lap 22 VSC pit window and raced with the Haas pair before Sainz's post-race penalty lifted Cadillac's best car to P14.",
        "tag": "vsc-window-final-p14"
      }
    }
  },
